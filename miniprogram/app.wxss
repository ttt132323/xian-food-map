page {
  --paper: #F6F1E7;
  --card: #FFFCF6;
  --ink: #241F1A;
  --ink-2: #5B5145;
  --ink-3: #8A7E6C;
  --red: #A6392B;
  --jade: #2F5D57;
  --dawn: #2A5560;
  --line: #E2D8C6;
  --line-2: #EAE1D2;

  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.page {
  padding: 0 28rpx 60rpx;
  box-sizing: border-box;
}

/* 筛选按钮：小圆角方块，不是胶囊 */
.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: #FFFFFF;
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.35;
  transition: background .15s;
}

.chip.on {
  background: var(--red);
  border-color: var(--red);
  color: #FFF7EF;
  font-weight: 500;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}
