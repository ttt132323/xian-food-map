.page { padding: 0 28rpx 60rpx; }

.bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0 16rpx;
}

.search {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
}

.ico { font-size: 24rpx; margin-right: 10rpx; opacity: .5; }

.ipt { flex: 1; font-size: 26rpx; color: var(--ink); }

.ph { color: #B3A896; }

.loc {
  flex: 0 0 auto;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 24rpx;
}

.loc.on {
  background: var(--dawn);
  border-color: var(--dawn);
  color: #F2F8F7;
}

.frow {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.fl {
  flex: 0 0 64rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.chips {
  flex: 1;
  white-space: nowrap;
  display: flex;
  flex-direction: row;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 6rpx;
}

.anchor {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx 6rpx 8rpx;
  margin-left: -8rpx;
  border-radius: 8rpx;
}

.anchor-hover { background: #FBF7EF; }

.a-l { font-size: 21rpx; color: var(--ink-3); }

.a-v {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

.a-d { font-size: 17rpx; color: var(--red); margin-top: 2rpx; }

.count {
  font-size: 21rpx;
  color: var(--ink-3);
}

.item {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.item-hover { background: #FBF7EF; }

.r { flex: 1; min-width: 0; }

.n {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.nm {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}

.tag {
  font-size: 19rpx;
  line-height: 1.5;
  padding: 0 8rpx;
  border-radius: 4rpx;
}

.tag.ok { color: var(--jade); background: #EEF5F3; }
.tag.off { color: #A99D8B; background: #F2EEE5; }
.tag.dim { color: #8C8172; background: #F2EEE5; }

.m {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.d {
  flex: 0 0 auto;
  text-align: right;
  margin-left: 16rpx;
}

.dv {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--dawn);
}

.dl {
  display: block;
  font-size: 19rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.arrow {
  margin-left: 10rpx;
  color: #CFC5B2;
  font-size: 34rpx;
  line-height: 1;
}

.foot {
  padding: 30rpx 0 0;
  text-align: center;
  font-size: 21rpx;
  color: #B3A896;
}
