/* 首页 = 顶部地图 + 下面列表，像地图软件的结果页 */
.page {
  padding: 0;
  box-sizing: border-box;
}

/* ---------- 顶部地图 ---------- */
.map-head {
  position: relative;
  width: 100%;
  height: 34vh;
  background: #E8E1D4;
}

.mini-map {
  width: 100%;
  height: 100%;
}

.search-float {
  position: absolute;
  top: 20rpx;
  left: 24rpx;
  right: 24rpx;
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 4rpx 16rpx rgba(36, 31, 26, 0.12);
  z-index: 10;
}

.ico { font-size: 24rpx; margin-right: 10rpx; opacity: .5; }

.ipt { flex: 1; font-size: 26rpx; color: var(--ink); }

.ph { color: #B3A896; }

.map-expand {
  position: absolute;
  right: 24rpx;
  bottom: 20rpx;
  padding: 10rpx 22rpx;
  border-radius: 10rpx;
  background: rgba(255, 252, 246, 0.95);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 21rpx;
  box-shadow: 0 4rpx 14rpx rgba(36, 31, 26, 0.1);
  z-index: 10;
}

.me-hover { background: #F0EBE0; }

/* ---------- 列表区 ---------- */
.body {
  padding: 16rpx 28rpx 60rpx;
  background: var(--paper);
  border-radius: 20rpx 20rpx 0 0;
  margin-top: -18rpx;
  position: relative;
  z-index: 11;
}

.frow {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.fl {
  flex: 0 0 64rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.chips {
  flex: 1;
  white-space: nowrap;
  display: flex;
  flex-direction: row;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 4rpx;
}

.anchor {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 14rpx 6rpx 8rpx;
  margin-left: -8rpx;
  border-radius: 8rpx;
}

.anchor-hover { background: #FBF7EF; }

.a-l { font-size: 21rpx; color: var(--ink-3); }

.a-v {
  font-size: 24rpx;
  color: var(--red);
  font-weight: 600;
}

.a-d { font-size: 17rpx; color: var(--red); margin-top: 2rpx; }

.loc {
  padding: 8rpx 22rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 22rpx;
}

.loc.on {
  background: var(--dawn);
  border-color: var(--dawn);
  color: #F2F8F7;
}

.count {
  padding: 12rpx 0 4rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--line-2);
}

.item-hover { background: #FBF7EF; }

.r { flex: 1; min-width: 0; }

.n {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 10rpx;
}

.nm {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}

.tag {
  font-size: 19rpx;
  line-height: 1.5;
  padding: 0 8rpx;
  border-radius: 4rpx;
}

.tag.ok { color: var(--jade); background: #EEF5F3; }
.tag.off { color: #A99D8B; background: #F2EEE5; }
.tag.dim { color: #8C8172; background: #F2EEE5; }

.m {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  line-height: 1.5;
}

.d {
  flex: 0 0 auto;
  text-align: right;
  margin-left: 16rpx;
}

.dv {
  display: block;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--dawn);
}

.dl {
  display: block;
  font-size: 19rpx;
  color: var(--ink-3);
  margin-top: 2rpx;
}

.arrow {
  margin-left: 10rpx;
  color: #CFC5B2;
  font-size: 34rpx;
  line-height: 1;
}

.foot {
  padding: 30rpx 0 0;
  text-align: center;
  font-size: 21rpx;
  color: #B3A896;
}
