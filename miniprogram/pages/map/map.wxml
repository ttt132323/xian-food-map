<view class="wrap">

  <map class="map"
       latitude="{{lat}}"
       longitude="{{lng}}"
       scale="{{scale}}"
       markers="{{markers}}"
       include-points="{{incPts}}"
       show-location="{{true}}"
       enable-zoom="{{true}}"
       enable-scroll="{{true}}"
       bindmarkertap="onMarker"></map>

  <view class="tool" bindtap="showAll">全部</view>

  <view class="card" wx:if="{{cur}}">
    <view class="cn">{{cur.n}}</view>
    <view class="cm">{{cur.a}} · {{cur.t}}</view>
    <view class="cd" wx:if="{{cur.lv === 0}}">位置是片区估算，导航不准</view>
    <view class="cd" wx:elif="{{dist}}">{{dist}}</view>
    <view class="alist" wx:if="{{areaList.length}}">
      <text class="ai" wx:for="{{areaList}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="acts" wx:if="{{!areaList.length}}">
      <view class="btn" wx:if="{{cur.lv === 1}}" bindtap="navTo">导航过去</view>
      <view class="btn ghost" bindtap="copyName">复制店名</view>
    </view>
    <view class="acts" wx:if="{{areaList.length}}">
      <view class="btn ghost wide" bindtap="copyArea">复制这一片的店名</view>
    </view>
  </view>

</view>
