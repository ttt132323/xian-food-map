.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.tool {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  padding: 12rpx 26rpx;
  border-radius: 10rpx;
  background: rgba(255, 252, 246, 0.96);
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  font-size: 23rpx;
  box-shadow: 0 4rpx 14rpx rgba(36, 31, 26, 0.1);
}

.card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 48rpx;
  padding: 26rpx 28rpx;
  border-radius: 18rpx;
  background: #FFFCF6;
  box-shadow: 0 8rpx 30rpx rgba(36, 31, 26, 0.14);
}

.cn {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--ink);
}

.cm {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.cd {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--dawn);
  font-weight: 500;
}

.must {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.mu-l {
  font-size: 20rpx;
  color: var(--ink-3);
  margin-right: 2rpx;
}

.mu-i {
  font-size: 22rpx;
  color: var(--dawn);
  background: #EAF1F1;
  border-radius: 6rpx;
  padding: 5rpx 14rpx;
}

.alist {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.ai {
  font-size: 22rpx;
  color: var(--ink-2);
  background: #F5F0E4;
  border-radius: 6rpx;
  padding: 6rpx 14rpx;
}

.acts {
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 12rpx;
  background: var(--dawn);
  color: #F2F8F7;
  font-size: 28rpx;
}

.btn.ghost {
  flex: 0 0 auto;
  padding: 22rpx 30rpx;
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}

.btn.ghost.wide { flex: 1; padding: 22rpx 0; }
