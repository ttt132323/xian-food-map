.wrap {
  position: relative;
  width: 100vw;
  height: 100vh;
}

.map {
  width: 100%;
  height: 100%;
}

.tip {
  position: absolute;
  top: 40rpx;
  left: 32rpx;
  right: 32rpx;
  padding: 20rpx 24rpx;
  border-radius: 14rpx;
  background: rgba(255, 252, 246, 0.96);
  color: var(--ink-2);
  font-size: 24rpx;
  line-height: 1.55;
}

.card {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 44rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #FFFCF6;
  box-shadow: 0 10rpx 36rpx rgba(36, 31, 26, 0.14);
}

.cn {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.cm {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--ink-3);
}

.note {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.55;
}

.acts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 14rpx;
  background: var(--dawn);
  color: #F2F8F7;
  font-size: 27rpx;
}

.btn.ghost {
  flex: 0 0 auto;
  padding: 20rpx 34rpx;
  background: transparent;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
}
