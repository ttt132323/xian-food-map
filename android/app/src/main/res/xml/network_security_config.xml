<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 应用内只允许 HTTPS；本地资源走 appassets 的 https 映射 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
